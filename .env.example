# Copy this file to .env and fill in real values. .env is gitignored.

# Toggles debug behaviour and log verbosity: local / staging / production
ENVIRONMENT=local

# Postgres connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://taskuser:taskpass@localhost:5432/taskdb

# Redis connection used for verification/reset tokens and login lockouts
REDIS_URL=redis://localhost:6379/0

# Signs access/refresh JWTs -- generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Failed logins before lockout, and lockout duration once the threshold is hit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Redis TTLs for single-use tokens
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Gmail SMTP -- use an App Password (Google Account > Security > App passwords),
# never the real account password. See README for setup steps.
GMAIL_USER=yourapp@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
MAIL_FROM_NAME=Task Manager

# Base URL used to build verification/reset links sent by email
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=INFO
